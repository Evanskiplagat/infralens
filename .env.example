# AWS credentials are resolved via the standard SDK chain (profile,
# environment, assumed role, instance role). These are optional
# overrides — CLI flags (--profile, --region, --db) win over all of them.
AWS_PROFILE=
AWS_REGION=

# Path to the local SQLite scan database. Defaults to ./infralens.db.
INFRALENS_DB_PATH=

# info | debug
INFRALENS_LOG_LEVEL=info
